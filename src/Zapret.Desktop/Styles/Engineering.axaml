<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Engineering.canvas">#101112</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.nav">#111214</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.surface">#131416</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.hover">#1C1E21</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.active">#222428</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.border">#292C30</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.control">#62676F</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.text">#E5E5E5</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.secondary">#A0A3A8</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.muted">#92979F</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.node">#8E949D</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.good">#42C98B</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.goodBg">#14271E</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.warn">#D5B453</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.warnBg">#2B2618</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.bad">#E06C75</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.badBg">#2B1B20</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.badHover">#371E25</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.info">#6C92D9</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.infoBg">#1B2537</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.primary">#E5E5E5</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.primaryHover">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.onPrimary">#101112</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.disabled">#202226</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.disabledText">#969BA3</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Engineering.canvas">#F5F6F7</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.nav">#ECEEF0</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.surface">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.hover">#E9EBEE</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.active">#E0E3E7</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.border">#CFD3D8</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.control">#7A818B</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.text">#24282D</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.secondary">#5B626C</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.muted">#656D77</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.node">#7E858F</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.good">#206D48</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.goodBg">#E5F1E9</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.warn">#795C1E</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.warnBg">#F2EBD9</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.bad">#A53A48</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.badBg">#F5E6E9</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.badHover">#EED4D9</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.info">#365E9D</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.infoBg">#E5ECF7</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.primary">#24282D</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.primaryHover">#111418</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.onPrimary">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.disabled">#E2E5E9</SolidColorBrush>
          <SolidColorBrush x:Key="Engineering.disabledText">#606872</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <FontFamily x:Key="Engineering.Font">avares://Zapret.Desktop/Assets/Fonts#JetBrains Mono</FontFamily>
    </ResourceDictionary>
  </Styles.Resources>
  <Style Selector="Window.engineering">
    <Setter Property="FontFamily" Value="{StaticResource Engineering.Font}" />
    <Setter Property="Foreground" Value="{DynamicResource Engineering.text}" />
  </Style>
  <Style Selector="Button.engineering">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Border Name="PART_EngineeringSurface" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Foreground="{TemplateBinding Foreground}" />
          </Border>
          <Border Name="PART_FocusRing" BorderThickness="2" BorderBrush="Transparent"
                  CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.engineering:pointerover /template/ Border#PART_EngineeringSurface">
    <Setter Property="Background" Value="{DynamicResource Engineering.hover}" />
  </Style>
  <!-- Fluent's content presenter also paints state backgrounds. Keep the surface
       on the frame so it cannot obscure the approved primary/danger colors. -->
  <Style Selector="Button.engineering:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   Button.engineering:pressed /template/ ContentPresenter#PART_ContentPresenter,
                   Button.engineering:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Engineering.text}" />
  </Style>
  <Style Selector="Button.engineering.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Engineering.onPrimary}" />
  </Style>
  <Style Selector="Button.engineering.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   Button.engineering.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Engineering.bad}" />
  </Style>
  <Style Selector="Button.engineering:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector="Button.engineering.primary:pointerover /template/ Border#PART_EngineeringSurface">
    <Setter Property="Background" Value="{DynamicResource Engineering.primaryHover}" />
  </Style>
  <Style Selector="Button.engineering.danger:pointerover /template/ Border#PART_EngineeringSurface">
    <Setter Property="Background" Value="{DynamicResource Engineering.badHover}" />
  </Style>
  <Style Selector="Button.engineering:pressed /template/ Border#PART_EngineeringSurface">
    <Setter Property="Background" Value="{DynamicResource Engineering.active}" />
  </Style>
  <Style Selector="Button.engineering.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Engineering.text}" />
  </Style>
  <Style Selector="Button.engineering:disabled /template/ Border#PART_EngineeringSurface">
    <Setter Property="Background" Value="{DynamicResource Engineering.disabled}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Engineering.border}" />
  </Style>
  <Style Selector="Button.engineering:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Engineering.disabledText}" />
  </Style>
  <Style Selector="Button.engineering:focus-visible /template/ Border#PART_FocusRing">
    <Setter Property="BorderBrush" Value="{DynamicResource Engineering.info}" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="15,0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="{DynamicResource Engineering.surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Engineering.text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Engineering.control}" />
  </Style>
  <Style Selector="ComboBox:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource Engineering.hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Engineering.control}" />
  </Style>
  <Style Selector="ComboBox:focus-visible /template/ Border#HighlightBackground">
    <Setter Property="BorderBrush" Value="{DynamicResource Engineering.info}" />
  </Style>
  <Style Selector="ComboBox /template/ Popup#PART_Popup">
    <Setter Property="MaxHeight" Value="360" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Engineering.hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Engineering.text}" />
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Engineering.active}" />
    <Setter Property="Foreground" Value="{DynamicResource Engineering.text}" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Engineering.infoBg}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Engineering.text}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Engineering.text}" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Engineering.control}" />
    <Setter Property="Background" Value="{DynamicResource Engineering.hover}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Engineering.info}" />
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource Engineering.info}" />
    <Setter Property="Background" Value="{DynamicResource Engineering.active}" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="CornerRadius" Value="3" />
  </Style>
</Styles>
